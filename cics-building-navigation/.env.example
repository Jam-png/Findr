# Copy this file to .env for local development. Never commit .env.
PORT=3000
NODE_ENV=development
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SECRET_OR_SERVICE_ROLE_KEY
JWT_SECRET=replace_with_a_random_secret_at_least_32_characters_long
ADMIN_REGISTRATION_CODE=replace_with_your_private_admin_code
SUPABASE_STORAGE_BUCKET=report-images

# Optional third-party email notifications (Resend)
RESEND_API_KEY=your_resend_api_key
EMAIL_FROM=Findr <onboarding@resend.dev>
